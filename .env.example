# Local simulation only. setup_postgres.ps1 generates .env with a random local password.
DEV_MODE=true
DATABASE_URL=postgresql+psycopg://after_sales:CHANGE_ME@127.0.0.1:55432/after_sales_dev
SESSION_TTL_SECONDS=3600
# system uses real UTC; fixture freezes business time from imported seeds in DEV_MODE only.
BUSINESS_CLOCK_MODE=system
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
